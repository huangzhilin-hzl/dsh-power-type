{
  "name": "dsh-power-type",
  "version": "0.2.0",
  "description": "Power Mode typing effects with a heat-and-ember text aura, combo reddening and synthesized impact audio for the DSH web composer.",
  "type": "module",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "huangzhilin",
  "homepage": "https://github.com/huangzhilin-hzl/dsh-power-type#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangzhilin-hzl/dsh-power-type.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "power-mode",
    "typing-effect",
    "web-composer",
    "particles",
    "sound"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  }
}
